---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Header } from "@/sections/Header";
import { CTASection } from "@/sections/Footer/components/CTASection";
import { Footer } from "@/sections/Footer";
import { projects } from "@/data/projects";
import { TrackedTelLink } from "@/components/TrackedTelLink";
import { absoluteUrl, brandName, business, citiesLabel } from "@/data/business";

const canonical = absoluteUrl("/guides");
const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical}#webpage`,
  url: canonical,
  name: `Solar Panel Cleaning Guides | ${brandName()}`,
  description: `Practical guides on solar panel cleaning, bird proofing and solar output from ${brandName()} in ${citiesLabel()}.`,
  isPartOf: { "@id": `${business.siteUrl}/#website` },
  inLanguage: "en-GB",
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: absoluteUrl("/") },
    { "@type": "ListItem", position: 2, name: "Guides", item: canonical },
  ],
};
---

<BaseLayout
  title={`Solar Panel Cleaning Guides | ${brandName()}`}
  description={`Guides to solar panel cleaning in Glasgow: how it works, how often to clean, pigeons under panels, commercial and farm arrays, and why output drops.`}
  canonical={canonical}
>
  <div class="text-neutral-600 text-lg not-italic normal-nums font-medium accent-auto bg-[#323232] box-border caret-transparent block tracking-[normal] leading-[27px] list-outside list-disc min-h-full pointer-events-auto text-start indent-[0px] normal-case visible border-separate font-manrope">
    <Header client:load />
    <main>
      <section class="box-border caret-transparent pt-[160px] pb-[70px] md:pt-[220px] md:pb-[100px]">
        <div class="box-border caret-transparent max-w-[1204px] mx-auto px-5 md:px-8 text-center">
          <p class="text-[#16a34a] text-sm font-semibold uppercase tracking-[0.18em] mb-4">Guides</p>
          <h1 class="text-white text-[34px] font-bold box-border caret-transparent leading-[44px] mb-5 md:text-[64px] md:leading-[78px]">
            Solar Panel <span class="text-[#16a34a]">Cleaning Guides</span>
          </h1>
          <p class="text-slate-200 box-border caret-transparent max-w-[780px] mx-auto">
            Straight answers on keeping solar panels clean and productive in the west of Scotland. Questions about your own panels? Call <TrackedTelLink client:load showPhoneNumber className="text-[#16a34a] hover:underline font-semibold" trackingLocation="guides" />.
          </p>
        </div>
      </section>

      <section class="box-border caret-transparent pb-[80px] md:pb-[120px]">
        <div class="box-border caret-transparent max-w-[1204px] mx-auto px-5 md:px-8">
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {projects.map((guide) => (
              <a href={`/guides/${guide.slug}`} class="rounded-xl bg-neutral-900/75 border border-white/10 overflow-hidden hover:border-[#16a34a] transition-colors block">
                <img src={guide.image} alt={guide.imageAlt} width="600" height="450" loading="lazy" class="w-full h-48 object-cover" />
                <div class="p-5">
                <h2 class="text-white text-lg font-bold mb-2">{guide.title}</h2>
                <p class="text-slate-300 text-sm">{guide.description}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <CTASection client:load />
    </main>
    <Footer client:load />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>
